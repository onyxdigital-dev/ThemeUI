$logo_allowed_mimes = ["image/png"=>"png","image/jpeg"=>"jpg","image/webp"=>"webp","image/gif"=>"gif"];

function themeui_logo_svg($src) {
    $src = htmlspecialchars($src, ENT_QUOTES);
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 222.36 39.04" class="xs:w-[16rem] h-auto max-h-[3rem] w-[14rem] shrink-0" aria-hidden="true" focusable="false"><image href="' . $src . '" x="0" y="0" width="222.36" height="39.04" preserveAspectRatio="xMidYMid meet"/></svg>';
}

function themeui_apply_logo($mode, $src) {
    global $logo_header_file, $logo_anim_file, $logo_backup_dir;
    if (!file_exists($logo_header_file)) return;
    if (!is_dir($logo_backup_dir)) @mkdir($logo_backup_dir, 0755, true);
    $backup_header = "$logo_backup_dir/UN-logotype-gradient.svg";
    $backup_anim   = "$logo_backup_dir/animated-logo.svg";
    if (!file_exists($backup_header)) @copy($logo_header_file, $backup_header);
    if (file_exists($logo_anim_file) && !file_exists($backup_anim)) @copy($logo_anim_file, $backup_anim);

    if ($mode === 'none' || !$src) {
        if (file_exists($backup_header)) @copy($backup_header, $logo_header_file);
        if (file_exists($backup_anim))   @copy($backup_anim, $logo_anim_file);
        return;
    }
    $svg = themeui_logo_svg($src);
    @file_put_contents($logo_header_file, $svg);
    @file_put_contents($logo_anim_file, $svg);
}

$error = "";

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_POST['SAVE_CONFIG'])) {
        $service = (isset($_POST['SERVICE']) && $_POST['SERVICE'] === 'enabled') ? 'enabled' : 'disabled';
        $theme   = in_array($_POST['THEME']  ?? '', $valid_themes)  ? $_POST['THEME']  : 'default';
        $design  = in_array($_POST['DESIGN'] ?? '', $valid_designs) ? $_POST['DESIGN'] : 'default';

        $logo_mode = in_array($_POST['LOGO_MODE'] ?? '', $valid_logo_modes) ? $_POST['LOGO_MODE'] : 'none';
        $logo_url  = trim($_POST['logo_url'] ?? '');

        $existing_upload = null;
        foreach (glob("$logo_upload_dir/custom-logo.*") as $f) { $existing_upload = basename($f); }

        if ($logo_mode === 'upload' && isset($_FILES['logo_file']) && $_FILES['logo_file']['error'] === UPLOAD_ERR_OK && $_FILES['logo_file']['size'] > 0) {
            if ($_FILES['logo_file']['size'] <= 20 * 1024 * 1024) {
                $finfo = finfo_open(FILEINFO_MIME_TYPE);
                $mime  = finfo_file($finfo, $_FILES['logo_file']['tmp_name']);
                finfo_close($finfo);
                if (isset($logo_allowed_mimes[$mime])) {
                    foreach (glob("$logo_upload_dir/custom-logo.*") as $old) @unlink($old);
                    foreach (glob("$logo_webroot/custom-logo.*") as $old) @unlink($old);
                    $ext  = $logo_allowed_mimes[$mime];
                    $dest = "$logo_upload_dir/custom-logo.$ext";
                    move_uploaded_file($_FILES['logo_file']['tmp_name'], $dest);
                    @copy($dest, "$logo_webroot/custom-logo.$ext");
                    $existing_upload = "custom-logo.$ext";
                } else {
                    $error = "Logo not saved - unsupported image type. Use PNG, JPG, WEBP, or GIF.";
                }
            } else {
                $error = "Logo not saved - file too large (20MB max).";
            }
        }

        $logo_src = '';
        if ($logo_mode === 'url' && $logo_url !== '') {
            $logo_src = $logo_url;
        } elseif ($logo_mode === 'upload' && $existing_upload) {
            $logo_src = "/plugins/ThemeUI/$existing_upload";
        } else {
            $logo_mode = 'none';
        }
        themeui_apply_logo($logo_mode, $logo_src);

        file_put_contents($cfg_path, "SERVICE=\"$service\"\nTHEME=\"$theme\"\nDESIGN=\"$design\"\nLOGO_MODE=\"$logo_mode\"\nLOGO_URL=\"$logo_url\"\n");
        if (isset($_POST['custom_css'])) {
            file_put_contents($override_path, $_POST['custom_css']);
            @copy($override_path, $webroot_override);
        }
        $login_page = "/usr/local/emhttp/webGui/include/.login.php";
        if (file_exists($login_page)) {
            $plug = "/usr/local/emhttp/plugins/ThemeUI";
            $html = file_get_contents($login_page);
            $html = preg_replace('/<!--themeui-start-->.*?<!--themeui-end-->\n?/s', '', $html);
            if ($service === 'enabled' && $theme !== 'default') {
                $css  = @file_get_contents("$plug/themes/$theme.css") ?: '';
                $css .= "\n" . (@file_get_contents("$plug/themes/login.css") ?: '');
                $block = "<!--themeui-start-->\n<style>\n$css\n</style>\n<!--themeui-end-->";
                $html = str_replace('</head>', "$block\n</head>", $html);
            }
            file_put_contents($login_page, $html);
            if (function_exists('opcache_reset')) {
                opcache_reset();
            } elseif (function_exists('opcache_invalidate')) {
                opcache_invalidate($login_page, true);
            }
        }
        $msg = $error ? "Settings saved - $error" : "Settings saved - applying theme...";
    }
}

if (!file_exists($cfg_path)) {
    file_put_contents($cfg_path, "SERVICE=\"disabled\"\nTHEME=\"default\"\n");
}
if (!file_exists($override_path)) {
    file_put_contents($override_path, "");
    @copy($override_path, $webroot_override);
